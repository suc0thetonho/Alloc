# Porta em que o servidor irá escutar
PORT=3000

# Ambiente de execução (development, test, production)
NODE_ENV=development

# Origens permitidas para o CORS (separadas por vírgula ou '*' para liberar geral)
CORS_ORIGIN=*

# URL de conexão do PostgreSQL (não use credenciais reais neste arquivo)
# Exemplo: postgresql://usuario:senha@localhost:5432/alloc_link
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alloc_link

# Número máximo de conexões simultâneas do pool
DB_POOL_MAX=10
